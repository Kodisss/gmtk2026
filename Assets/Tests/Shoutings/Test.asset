  lines:
  - speaker: {fileID: 11400000, guid: fe8e49dcead5893438ac9f7d55091e15, type: 2}
    text: I wonder how you guys are doing?
    typingSpeed: 1
    voiceVolume: 1
    waitAfter: 0.5
  - speaker: {fileID: 11400000, guid: eaefd72abfa294241b78fdc739b5dea7, type: 2}
    text: Shut the fuck up bitch! I hate you.
    typingSpeed: 1
    voiceVolume: 1
    waitAfter: 2
  - speaker: {fileID: 11400000, guid: 5a7a072977255934c9fdb9742100db1f, type: 2}
    text: That's mean actually...
    typingSpeed: 1
    voiceVolume: 1
    waitAfter: 0.5
  - speaker: {fileID: 11400000, guid: fe8e49dcead5893438ac9f7d55091e15, type: 2}
    text: Yes, I am very hurt by what you said.
    typingSpeed: 1
    voiceVolume: 1
    waitAfter: 0.5
  - speaker: {fileID: 11400000, guid: eaefd72abfa294241b78fdc739b5dea7, type: 2}
    text: I actually don't care, I hope you die!
    typingSpeed: 1
    voiceVolume: 1
    waitAfter: 0.5
  - speaker: {fileID: 11400000, guid: 5a7a072977255934c9fdb9742100db1f, type: 2}
