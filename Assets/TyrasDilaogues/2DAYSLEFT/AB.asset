  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: AB
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 0
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: -6872186827961725178, guid: ff2e9e450f85cbc4fb0884745e73e1fb, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Adapt? Haha
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "That sounds... awful. What would that look like, I wonder? \r\n"
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "Something the slow, sure death of a depleting society? The tears of anguish
      as we eventually all realize, like I have already realized, that any hope is
      futile? \r\n"
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "Something like that, yes. \r\n"
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'You should know that you dream far too big for a mere robot. Even if you
      manage to "fight" and "beat" me, you are pathetically directionless.

'
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: -8442755936475116147, guid: 19c69b3e329db5c429c341e483207478, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: We can't make any plans if the world is destroyed.
    nextDialogue: {fileID: 11400000, guid: 7f04781426269634abb9e62da98c8325, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 2
      value: 1
    onSelected:
      m_PersistentCalls:
        m_Calls: []
  - text: 'In a way, we have already adapted. '
    nextDialogue: {fileID: 11400000, guid: e4eff22a18321eb4f8587e4d0269b67c, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 1
      value: 1
    onSelected:
      m_PersistentCalls:
        m_Calls: []
