  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: AA
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 0
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: c24a7b4c4ab702e40ad119184336e7ae, type: 3}
    voiceVolume: 1.15
    text: Ugh!
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: c24a7b4c4ab702e40ad119184336e7ae, type: 3}
    voiceVolume: 1
    text: You! Don't! Know! Anything!
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "You\u2019re just a machine. How could you possibly comprehend what I\u2019m
      trying to accomplish? What it means for us?"
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'What I am doing is an act of ultimate mercy!

'
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1.15
    text: Mercy!
    typingSpeed: 1.79
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "This ugly, doomed world has nothing to offer. What awaits Bunnykind if
      you \u201Cspare\u201D them will be unending and complete suffering. "
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'They are already suffering now!

'
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: 21300000, guid: f38a222d19b75354baf0ce9421ce6445, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: No, they seem kind of happy, actually.
    nextDialogue: {fileID: 11400000, guid: dbf706cb8603aec4aa4d178d22a8317c, type: 2}
    conditions:
    - variable: 0
      condition: 3
      value: 2
    effects:
    - variable: 0
      operation: 1
      value: 1
    onSelected:
      m_PersistentCalls:
        m_Calls: []
  - text: Yes, but it does not mean you need to blow up the whole world.
    nextDialogue: {fileID: 0}
    conditions: []
    effects:
    - variable: 0
      operation: 2
      value: 1
    onSelected:
      m_PersistentCalls:
        m_Calls: []
  - text: Maybe it's how it's meant to be, then.
    nextDialogue: {fileID: 0}
    conditions:
    - variable: 0
      condition: 4
      value: 0
    effects:
    - variable: 0
      operation: 2
      value: 1
    onSelected:
      m_PersistentCalls:
        m_Calls: []
