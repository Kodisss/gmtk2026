%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: AAB
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 2
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 5035677201601703499, guid: 49f8dc94f1446e24b923f30caecc9884, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "What do you know about what it\u2019s like to suffer!? I will tell you
      now so that you understand.\r\n"
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'Pain. Grief. Regret. Hate. Sadness. '
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'All you ever wish for is for it all to end. '
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "And\u2026 the amount of love you must possess to bestow the gift of a
      peaceful death unto your people\u2026 is bigger and more complex than what
      your old circuits can understand."
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: ...
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: I used to be responsible for them all, you know.
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'I was gonna save the world twice over. '
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: ...
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Hm. I'm feeling wistful today. I wish to be left alone now.
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Goodbye.
    typingSpeed: 1
  ChoicePortraits: []
  ChoicePortraitAnimationFPS: 8
