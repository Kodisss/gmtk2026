  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: ABB
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 0
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Well, little bot, it's been almost fourteen years.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'You haven''t been around to see it. '
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: I stopped trying to look for hope a long time ago.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'I suggest you stop looking too. '
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'Soon, we will all be nothing but a good memory. There is power in that,
      too, is there not?

'
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: 21300000, guid: f38a222d19b75354baf0ce9421ce6445, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: Yes.
    nextDialogue: {fileID: 11400000, guid: 927193469c1c33645b748875c5620e50, type: 2}
