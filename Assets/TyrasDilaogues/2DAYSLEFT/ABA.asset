--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: ABA
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 2
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "Well, little bot, it's been almost fourteen years. \r\n"
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: No "plans" have bested that damned foliage yet. I mean... you were supposed
      to be the solution to that, and look where we are now.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: ...
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "I really believed we were going to persevere. Such a silly mistake. It
      shouldn't have become... this. \r\n"
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: ...
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'Well, look at the time. Don''t you need to charge your batteries? Begone
      from my lab.

'
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: ...
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'And do let me know how "adapting" works out for you.

'
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Goodbye.
    typingSpeed: 1
