  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: 4DAYSLEFT B
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 0
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 21300000, guid: a969c6cf5888b5e47b18c98739fba120, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Oh. Are you sure?
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Actually, no. Whatever. I don't want to tell you anyway.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: ...
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: ...You're frustrating. I thought we programmed you to be curious.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "Yet another one of the Coalition\u2019s failures, I suppose. I will set
      those mistakes right."
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: a969c6cf5888b5e47b18c98739fba120, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "\u2026Aren\u2019t you even a little curious about Bunnykind\u2019s misery?
      About the fate of your creators?"
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: 21300000, guid: f38a222d19b75354baf0ce9421ce6445, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: Bunnykind isn't miserable. They seem to be happily trading with each other.
    nextDialogue: {fileID: 11400000, guid: 9506e833a621614499a6e156faead176, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 1
      value: 1
    onSelected:
