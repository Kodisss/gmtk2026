    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "Then why do you oppose me? \r\n"
    typingSpeed: 1
  - portrait:
    - {fileID: 5035677201601703499, guid: 49f8dc94f1446e24b923f30caecc9884, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Why do you have the right to deny Bunnykind their peaceful, dignified end?
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: -8442755936475116147, guid: 19c69b3e329db5c429c341e483207478, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: Because I have not made friends with all of them, and I do not know if
      they want their life cut short.
