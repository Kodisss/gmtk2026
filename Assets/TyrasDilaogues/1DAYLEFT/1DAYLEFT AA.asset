    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Would you cut your friend's life short, if you knew that there was only
      suffering ahead of them?
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: -8442755936475116147, guid: 19c69b3e329db5c429c341e483207478, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: Leave it be, since it isn't my choice to make for them.
    nextDialogue: {fileID: 11400000, guid: cbcc835f66245a24bba6f10a0d180132, type: 2}
    conditions: []
    effects: []
    onSelected:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Let them have a peaceful end. '
