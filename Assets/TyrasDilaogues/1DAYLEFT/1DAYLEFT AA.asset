    conditions: []
    effects: []
    onSelected:
      m_PersistentCalls:
        m_Calls: []
  - text: Living and suffering are not mutually exclusive.
    nextDialogue: {fileID: 11400000, guid: cdfb1af1e56b74d4893eebfba85f3310, type: 2}
