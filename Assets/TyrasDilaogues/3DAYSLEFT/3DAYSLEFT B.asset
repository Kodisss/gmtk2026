  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: 3DAYSLEFT B
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 0
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 5035677201601703499, guid: 49f8dc94f1446e24b923f30caecc9884, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: You don't need to understand my reasons. A robot like you probably wouldn't
      grasp the nuance anyway!
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'And besides, who knows what lies Lepus has told you.

'
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: He doesn't understand the first thing about the world. He is blinded by
      optimism. I'm doing Bunnykind a service, because I cannot bear to see them
      suffer a slow and painful decline.
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: -8442755936475116147, guid: 19c69b3e329db5c429c341e483207478, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: Intervening just means taking Bunnykind's choice away.
    nextDialogue: {fileID: 11400000, guid: e6ab850ffd14d4440a9af12e4ead3f35, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 2
      value: 1
    onSelected:
      m_PersistentCalls:
        m_Calls: []
  - text: What is your deal with Lepus anyway?
    nextDialogue: {fileID: 11400000, guid: 255e8b40116551245ae41cea436bceb7, type: 2}
    conditions:
    - variable: 0
      condition: 3
