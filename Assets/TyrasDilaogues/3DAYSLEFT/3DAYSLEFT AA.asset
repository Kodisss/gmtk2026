  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: 3DAYSLEFT AA
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 0
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: What? No... that stopped years ago. They're still doing stuff like that?
    typingSpeed: 1
  - portrait:
    - {fileID: 5035677201601703499, guid: 49f8dc94f1446e24b923f30caecc9884, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: No. Stop! You're trying to confuse me.
    typingSpeed: 1
  - portrait:
    - {fileID: 5035677201601703499, guid: 49f8dc94f1446e24b923f30caecc9884, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'I will NOT take meditation classes. You don''t even know if they''re truly
      still going, or if it''s just something the bunnies say to comfort themselves.

'
    typingSpeed: 1
  - portrait:
    - {fileID: 5035677201601703499, guid: 49f8dc94f1446e24b923f30caecc9884, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: You have no nuance, machine!
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: -8442755936475116147, guid: 19c69b3e329db5c429c341e483207478, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: I don't need to know.
    nextDialogue: {fileID: 11400000, guid: ac518c105b202674da140f545cc3256f, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 1
      value: 0
    onSelected:
      m_PersistentCalls:
        m_Calls: []
  - text: Then tell me what I am missing.
    nextDialogue: {fileID: 11400000, guid: 89d1dc170b8d7e24f86a003f55a97464, type: 2}
    conditions:
    - variable: 0
      condition: 3
