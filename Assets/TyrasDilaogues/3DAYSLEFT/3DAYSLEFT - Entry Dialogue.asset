  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: 3DAYSLEFT - Entry Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 0
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: c24a7b4c4ab702e40ad119184336e7ae, type: 3}
    voiceVolume: 1.27
    text: GAHHHHHH!!!!
    typingSpeed: 4.23
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Don't you get the hint!?
    typingSpeed: 1.91
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Have I not been clear!?
    typingSpeed: 3.13
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: c24a7b4c4ab702e40ad119184336e7ae, type: 3}
    voiceVolume: 1.42
    text: Leave! Me! Alone!!!
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: I won't change my mind. I am doing this, because I know it is right.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'There is no one left from the Coalition who sees reason like I do. They
      all believe this can all just be fixed. '
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Haha. What rubbish.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: c24a7b4c4ab702e40ad119184336e7ae, type: 3}
    voiceVolume: 1.34
    text: THE WORLD IS ALREADY DESTROYED AND UNSALVAGEABLE!!!
    typingSpeed: 1.88
  ChoicePortraits:
  - {fileID: 21300000, guid: f38a222d19b75354baf0ce9421ce6445, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: Maybe you need to take meditation classes.
    nextDialogue: {fileID: 11400000, guid: 33d58bd735cb2f14c9757484450c528a, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 1
      value: 1
    onSelected:
      m_PersistentCalls:
        m_Calls: []
  - text: And you want to fix it by destroying it...?
    nextDialogue: {fileID: 11400000, guid: 4a9b3db065bb5ce4f93c2eb6d2af9374, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 2
      value: 1
    onSelected:
      m_PersistentCalls:
        m_Calls: []
