  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: 3DAYSLEFT BAA
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 2
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Haha. Nice try.
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'I''m not that easy. The activation is almost complete, I''m not leaving
      you the chance to ruin the dignified ending I''ve worked for.

'
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'No more struggle. No more anguish.  No more guilt. No more regrets.

'
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: I suggest you perhaps consider the alternative to a peaceful ending.
    typingSpeed: 1
  - portrait:
    - {fileID: -4587358237732827174, guid: 53c612e55a1353848b4b98d67d941ce2, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: I have no interest in continuing this further. Goodbye.
    typingSpeed: 1
