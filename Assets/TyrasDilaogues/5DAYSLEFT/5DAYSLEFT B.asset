  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: 5DAYSLEFT B
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 2
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 21300000, guid: a969c6cf5888b5e47b18c98739fba120, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Haha.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: You're a lying little piece of scrap.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 1196278bb2e7134498a336c18461fd65, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: I can guess what your mission is. It seems he is still a fool, and a cruel
      one at that, trying to use my weakness against me. No matter.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "Unfortunately, you\u2019ll have to look elsewhere for a fight. I don\u2019t
      want to even look at you anymore. "
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Goodbye.
    typingSpeed: 1.51
