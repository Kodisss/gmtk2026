  m_Script: {fileID: 11500000, guid: bb50b23a4cf2d8b458c5808c80931e04, type: 3}
  m_Name: 5DAYSLEFT - Entry Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialogue.DialogueNode
  speakerName: Oryctola
  dialogueType: 0
  advanceDialogueDatabase: 1
  lines:
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "Science always has naysayers. My colleagues always used to say it\u2019s
      part of the job."
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "Unfortunately, I\u2019ve never had the patience to understand such a stupid
      worldview. I suggest you take your stupidity somewhere-"
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: Oh.
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: "It\u2019s been a while. I almost can\u2019t believe one is still working.
      \n"
    typingSpeed: 1
  - portrait:
    - {fileID: 21300000, guid: 8f2961def0ed6a048bab3643fe75a48e, type: 3}
    PortraitAnimationFPS: 8
    voiceClip: {fileID: 8300000, guid: 0e68174b74dce0a49b3e1e42ef9f7ef9, type: 3}
    voiceVolume: 1
    text: 'Little bot, what is your mission?

'
    typingSpeed: 1
  ChoicePortraits:
  - {fileID: 21300000, guid: f38a222d19b75354baf0ce9421ce6445, type: 3}
  ChoicePortraitAnimationFPS: 8
  choices:
  - text: To stop you from destroying the world.
    nextDialogue: {fileID: 11400000, guid: 282ae161bef5c794eaf37a5d55f205a5, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 1
      value: 0
  - text: I don't know.
    nextDialogue: {fileID: 11400000, guid: da24c34ed4f56ba48894ff683971f8f2, type: 2}
    conditions: []
    effects:
    - variable: 0
      operation: 2
